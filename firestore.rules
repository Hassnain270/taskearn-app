rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // users/{uid}
    // Client (app) is allowed to read its own document and update
    // only "safe" profile-type fields. Money fields (balance,
    // taskCount, todayEarnings, totalEarnings, tronAddress,
    // walletIndex, vip status) AND walletAddress/walletNetwork can
    // ONLY be written by the Admin SDK (Cloud Functions), never
    // directly by the client. Any cross-user lookup (login by
    // username, registration uniqueness checks, wallet uniqueness)
    // is handled by dedicated Cloud Functions instead of direct
    // client queries, since those must run BEFORE the user is
    // authenticated or need to see OTHER users' data.
    // ---------------------------------------------------------------
    match /users/{userId} {

      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !('balance' in request.resource.data)
                    && !('taskCount' in request.resource.data)
                    && !('todayEarnings' in request.resource.data)
                    && !('totalEarnings' in request.resource.data)
                    && !('tronAddress' in request.resource.data)
                    && !('walletAddress' in request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'phone', 'email', 'displayName',
                           'fullName', 'gender', 'dobText'
                         ]);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // withdrawals/{id}
    // Only Cloud Functions (Admin SDK, which bypasses these rules)
    // may create or modify withdrawal records. A normal user may
    // read only their own withdrawal history; an admin (isAdmin:true
    // on their own user doc) may read ALL withdrawals, needed for
    // the Withdrawal Approvals screen.
    // ---------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null
                  && (
                    resource.data.userId == request.auth.uid
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                  );
      allow write: if false; // server-only (Admin SDK bypasses rules)
    }

    // ---------------------------------------------------------------
    // transactions/{id}  (deposit / earning history shown in HistoryScreen)
    // Read-only for the owning user; written only by Cloud Functions.
    // ---------------------------------------------------------------
    match /transactions/{txId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // ---------------------------------------------------------------
    // depositAddresses/{id}  (live pending-deposit status watched by
    // DepositScreen.js so it can show a "Deposit Confirmed" popup).
    // ---------------------------------------------------------------
    match /depositAddresses/{depositId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // ---------------------------------------------------------------
    // metadata/{doc}  (e.g. wallet_counter)  — internal use only.
    // ---------------------------------------------------------------
    match /metadata/{docId} {
      allow read, write: if false; // server-only
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}