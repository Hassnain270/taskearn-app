rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // users/{uid}
    // Client (app) is allowed to read its own document and update
    // only "safe" profile-type fields. Money fields (balance,
    // taskCount, todayEarnings, totalEarnings, tronAddress,
    // walletIndex, vip status), walletAddress/walletNetwork, AND
    // isAdmin can ONLY be written by the Admin SDK (Cloud Functions),
    // never directly by the client. This is also enforced at account
    // CREATION time (not just update) — a user creating their own
    // document during registration cannot include any of these
    // fields, which most importantly prevents a user from setting
    // isAdmin: true on their own new account.
    //
    // Any cross-user lookup (login by username, registration
    // uniqueness checks, wallet uniqueness, admin user search) is
    // handled by dedicated Cloud Functions instead of direct client
    // queries, since those must run BEFORE the user is authenticated
    // or need to see OTHER users' data.
    // ---------------------------------------------------------------
    match /users/{userId} {

      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !('isAdmin' in request.resource.data)
                    && !('balance' in request.resource.data)
                    && !('totalBalance' in request.resource.data)
                    && !('taskCount' in request.resource.data)
                    && !('todayEarnings' in request.resource.data)
                    && !('totalEarnings' in request.resource.data)
                    && !('totalWithdraw' in request.resource.data)
                    && !('teamReward' in request.resource.data)
                    && !('tronAddress' in request.resource.data)
                    && !('walletAddress' in request.resource.data)
                    && !('walletNetwork' in request.resource.data)
                    && !('walletAddressUpdatedAt' in request.resource.data)
                    && !('lastClaimedVipLevel' in request.resource.data)
                    && !('hasDeposited' in request.resource.data)
                    && !('lastAdminEditBy' in request.resource.data)
                    && !('lastAdminEditAt' in request.resource.data);

      // Only these plain profile fields may ever be changed directly
      // by the client. Email and phone number changes are intended to
      // go through the app's OTP-verified flow before this write
      // happens, and isAdmin can never be touched here at all —
      // "phoneNumber" is included (matching the field name actually
      // used at registration) alongside the older "phone" name for
      // compatibility.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'phone', 'phoneNumber', 'email', 'displayName',
                           'fullName', 'gender', 'dobText'
                         ])
                    && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // withdrawals/{id}
    // Only Cloud Functions (Admin SDK, which bypasses these rules)
    // may create or modify withdrawal records. A normal user may
    // read only their own withdrawal history; an admin (isAdmin:true
    // on their own user doc) may read ALL withdrawals, needed for
    // the Withdrawal Approvals screen.
    // ---------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null
                  && (
                    resource.data.userId == request.auth.uid
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                  );
      allow write: if false; // server-only (Admin SDK bypasses rules)
    }

    // ---------------------------------------------------------------
    // transactions/{id}  (deposit / earning history shown in HistoryScreen)
    // Read-only for the owning user; written only by Cloud Functions.
    // ---------------------------------------------------------------
    match /transactions/{txId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // ---------------------------------------------------------------
    // depositAddresses/{id}  (live pending-deposit status watched by
    // DepositScreen.js so it can show a "Deposit Confirmed" popup).
    // ---------------------------------------------------------------
    match /depositAddresses/{depositId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // ---------------------------------------------------------------
    // metadata/{doc}  (e.g. wallet_counter)  — internal use only.
    // ---------------------------------------------------------------
    match /metadata/{docId} {
      allow read, write: if false; // server-only
    }

    // Deny everything else by default. This correctly and safely
    // covers every collection added since these rules were first
    // written — config/bonusRates, otps/{email},
    // passwordResetTokens/{token}, and users/{uid}/bonuses/{id} — none
    // of which are ever accessed directly by client code (only by
    // Cloud Functions via the Admin SDK, which bypasses these rules
    // entirely), so no explicit rule is needed for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}